@functions {
    private static IEnumerable<string> ParseTextItems(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            yield break;
        }

        raw = raw.Trim();
        var parsedItems = new List<string>();

        if (raw.StartsWith("[") && raw.EndsWith("]"))
        {
            try
            {
                using var document = System.Text.Json.JsonDocument.Parse(raw);
                if (document.RootElement.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    foreach (var item in document.RootElement.EnumerateArray())
                    {
                        var value = item.ValueKind == System.Text.Json.JsonValueKind.String ? item.GetString() : item.ToString();
                        if (!string.IsNullOrWhiteSpace(value))
                        {
                            parsedItems.Add(value.Trim());
                        }
                    }
                }
            }
            catch
            {
            }

            if (parsedItems.Count > 0)
            {
                foreach (var item in parsedItems)
                {
                    yield return item;
                }

                yield break;
            }
        }

        if (raw.StartsWith("{") && raw.EndsWith("}"))
        {
            try
            {
                using var document = System.Text.Json.JsonDocument.Parse(raw);
                if (document.RootElement.ValueKind == System.Text.Json.JsonValueKind.Object)
                {
                    foreach (var prop in document.RootElement.EnumerateObject())
                    {
                        var value = prop.Value.ToString();
                        if (!string.IsNullOrWhiteSpace(value))
                        {
                            parsedItems.Add($"{prop.Name}: {value.Trim()}");
                        }
                    }
                }
            }
            catch
            {
            }

            if (parsedItems.Count > 0)
            {
                foreach (var item in parsedItems)
                {
                    yield return item;
                }

                yield break;
            }
        }

        foreach (var part in raw.Split(new[] { ',', ';', '|', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries))
        {
            var trimmed = part.Trim();
            if (!string.IsNullOrWhiteSpace(trimmed))
            {
                yield return trimmed;
            }
        }
    }

    private static string FormatDescription(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return "<p style=\"color:#9ca3af; font-style:italic;\">Aucune description disponible pour ce poste.</p>";
        }

        var encoded = System.Net.WebUtility.HtmlEncode(raw.Trim())
            .Replace("\r\n", "\n")
            .Replace("\r", "\n")
            .Replace("\n", "<br/>");

        return $"<p>{encoded}</p>";
    }
}

