@section Scripts {
    <script>
        let currentPage = 1;
        const itemsPerPage = 10;
        let allCards = [];

        document.addEventListener('DOMContentLoaded', function() {
            const grid = document.getElementById('candidateGrid');
            if (grid) {
                const cards = grid.querySelectorAll('.candidate-card[data-candidate]');
                allCards = Array.from(cards);
                renderPagination();
                showPage(1);
            }
        });

        function renderPagination() {
            const totalPages = Math.ceil(allCards.length / itemsPerPage);
            const container = document.getElementById('paginationControls');
            if (!container) return;
            container.innerHTML = '';
            
            if (totalPages === 0) {
                const info = document.getElementById('paginationInfo');
                if(info) info.innerHTML = `Affichage de 0 à 0 sur 0 candidats`;
                return;
            }

            // Prev
            const prevBtn = document.createElement('button');
            prevBtn.className = `page-btn`;
            if(currentPage === 1) prevBtn.style.opacity = '0.5';
            prevBtn.innerHTML = `<i class="bi bi-chevron-left"></i>`;
            prevBtn.onclick = () => { if(currentPage > 1) showPage(currentPage - 1); };
            container.appendChild(prevBtn);

            // Pages
            for (let i = 1; i <= totalPages; i++) {
                const btn = document.createElement('button');
                btn.className = `page-btn ${currentPage === i ? 'active' : ''}`;
                btn.innerText = i;
                btn.onclick = () => showPage(i);
                container.appendChild(btn);
            }

            // Next
            const nextBtn = document.createElement('button');
            nextBtn.className = `page-btn`;
            if(currentPage === totalPages) nextBtn.style.opacity = '0.5';
            nextBtn.innerHTML = `<i class="bi bi-chevron-right"></i>`;
            nextBtn.onclick = () => { if(currentPage < totalPages) showPage(currentPage + 1); };
            container.appendChild(nextBtn);
        }

        function showPage(page) {
            currentPage = page;
            allCards.forEach(card => card.style.display = 'none');
            
            const totalItems = allCards.length;
