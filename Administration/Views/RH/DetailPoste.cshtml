        function renderPagination(tableId, containerId, filteredData, allData) {
            const totalPages = Math.ceil(filteredData.length / itemsPerPage);
            const container = document.getElementById(containerId);
            if (!container) return;
            container.innerHTML = '';
            
            const currentPage = tableId === 1 ? currentPage1 : currentPage2;
            const infoDiv = document.querySelector(tableId === 1 ? '.candidates-footer-info' : '#candidatesTable2 ~ .candidates-footer .candidates-footer-info');
            if (infoDiv && totalPages === 0) {
                infoDiv.innerHTML = `Affichage de <strong>0 à 0</strong> sur <strong>0</strong> candidats`;
            }

            if (totalPages === 0) return;

            // Prev
            const prevLi = document.createElement('li');
            prevLi.className = `page-item ${currentPage === 1 ? 'disabled' : ''}`;
            prevLi.innerHTML = `<a class="page-link" href="javascript:void(0)" onclick="if(${currentPage} > 1) showPage(${currentPage - 1}, ${tableId}, filteredRows${tableId}, allRows${tableId})" style="border-radius: 6px; color: ${currentPage === 1 ? '#cbd5e1' : '#64748b'};">Précédent</a>`;
            container.appendChild(prevLi);

            // Pages
            for (let i = 1; i <= totalPages; i++) {
                const li = document.createElement('li');
                li.className = `page-item ${currentPage === i ? 'active' : ''}`;
                li.innerHTML = `<a class="page-link" href="javascript:void(0)" onclick="showPage(${i}, ${tableId}, filteredRows${tableId}, allRows${tableId})" style="${currentPage === i ? 'background: #6366f1; border-color: #6366f1; border-radius: 6px; color: white;' : 'border-radius: 6px; color: #64748b;'}">${i}</a>`;
                container.appendChild(li);
            }

            // Next
            const nextLi = document.createElement('li');
            nextLi.className = `page-item ${currentPage === totalPages ? 'disabled' : ''}`;
            nextLi.innerHTML = `<a class="page-link" href="javascript:void(0)" onclick="if(${currentPage} < ${totalPages}) showPage(${currentPage + 1}, ${tableId}, filteredRows${tableId}, allRows${tableId})" style="border-radius: 6px; color: ${currentPage === totalPages ? '#cbd5e1' : '#64748b'};">Suivant</a>`;
            container.appendChild(nextLi);
        }

        function showPage(page, tableId, filteredData, allData) {
            if (tableId === 1) currentPage1 = page;
            else currentPage2 = page;

            allData.forEach(row => row.style.display = 'none');
            const totalItems = filteredData.length;
            if (totalItems === 0) return;

            const start = (page - 1) * itemsPerPage;
            const end = Math.min(start + itemsPerPage, totalItems);

            for (let i = start; i < end; i++) {
                filteredData[i].style.display = '';
            }

            const infoDiv = tableId === 1 
                ? document.querySelector('.candidates-footer-info') 
                : document.querySelectorAll('.candidates-footer-info')[1];
            
            if (infoDiv) {
                infoDiv.innerHTML = `Affichage de <strong>${start + 1} à ${end}</strong> sur <strong>${totalItems}</strong> candidats`;
            }
            
            renderPagination(tableId, `paginationControls${tableId}`, filteredData, allData);
        }

