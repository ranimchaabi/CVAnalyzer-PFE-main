        document.addEventListener('DOMContentLoaded', function() {
            // Setup Table 1
            const table1 = document.getElementById('candidatesTable');
            if (table1) {
                const tr1 = table1.getElementsByTagName('tbody')[0].getElementsByTagName('tr');
                allRows1 = Array.from(tr1);
